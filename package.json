{
  "name": "bb-plugin-thread-prs",
  "version": "0.1.2",
  "type": "module",
  "engines": {
    "bb": ">=0.49.0",
    "bbPluginSdk": ">=0.6.132 <0.7.0"
  },
  "bb": {
    "name": "Thread PR Manager",
    "description": "Manage pull requests across a thread and its child threads. Check CI, review feedback and run PR actions beside the composer.",
    "branding": {
      "icon": "GitPullRequest"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./host.ts"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "csstype": "3.2.3"
  },
  "description": "Show every GitHub pull request a bb thread and its child threads made, with live status.",
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "test": "bb plugin build . && node --import tsx --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/artkorotkikh-dfinity/bb-plugin-thread-prs.git"
